#: package/contents/ui/FullRepresentation.qml:57
msgid "Whisper Tiny – fastest"
msgstr "Whisper Tiny – am schnellsten"

#: package/contents/ui/FullRepresentation.qml:58
msgid "Whisper Base – balanced (recommended)"
msgstr "Whisper Base – ausgewogen (empfohlen)"

#: package/contents/ui/FullRepresentation.qml:59
msgid "Whisper Small – more accurate, more CPU"
msgstr "Whisper Small – genauer, mehr CPU"

#: package/contents/ui/FullRepresentation.qml:60
msgid "Google Online – fast, needs internet"
msgstr "Google Online – schnell, braucht Internet"

#: package/contents/ui/FullRepresentation.qml:63
msgid "Fast – short segments, little delay"
msgstr "Schnell – kurze Sätze, wenig Verzögerung"

#: package/contents/ui/FullRepresentation.qml:64
msgid "Balanced (recommended)"
msgstr "Ausgewogen (empfohlen)"

#: package/contents/ui/FullRepresentation.qml:65
msgid "Precise – whole sentences, more context"
msgstr "Genau – ganze Sätze, mehr Kontext"

#: package/contents/ui/FullRepresentation.qml:68
msgid "Google Translate – free"
msgstr "Google Übersetzer – kostenlos"

#: package/contents/ui/FullRepresentation.qml:69
msgid "DeepL – best quality (API key)"
msgstr "DeepL – beste Qualität (API-Schlüssel)"

#: package/contents/ui/FullRepresentation.qml:148
msgid "Switch translation on/off (middle-click on the icon works too)"
msgstr "Übersetzung ein-/ausschalten (Mittelklick aufs Symbol geht auch)"

#: package/contents/ui/FullRepresentation.qml:166
msgid "Quick select"
msgstr "Schnellauswahl"

#: package/contents/ui/FullRepresentation.qml:182
msgid "Click: select · Right-click: remove from quick select"
msgstr "Klicken: auswählen · Rechtsklick: aus der Schnellauswahl entfernen"

#: package/contents/ui/FullRepresentation.qml:195
msgid "Save current pair"
msgstr "Aktuelles Paar merken"

#: package/contents/ui/FullRepresentation.qml:212
msgid "From"
msgstr "Von"

#: package/contents/ui/FullRepresentation.qml:227
msgid "Swap languages"
msgstr "Sprachen tauschen"

#: package/contents/ui/FullRepresentation.qml:235
msgid "To"
msgstr "Nach"

#: package/contents/ui/FullRepresentation.qml:251
msgid ""
"One-time setup required: voices, translator and speech recognition will be "
"installed (about 5 minutes)."
msgstr ""
"Einmalige Einrichtung nötig: Stimmen, Übersetzer und Spracherkennung werden "
"installiert (ca. 5 Minuten)."

#: package/contents/ui/FullRepresentation.qml:254
msgid "Set up now"
msgstr "Jetzt einrichten"

#: package/contents/ui/FullRepresentation.qml:298
msgid "LIVE"
msgstr "LIVE"

#: package/contents/ui/FullRepresentation.qml:306
msgid "Delay %1 s"
msgstr "Versatz %1 s"

#: package/contents/ui/FullRepresentation.qml:313
msgid "· Tempo %1×"
msgstr "· Tempo %1×"

#: package/contents/ui/FullRepresentation.qml:319
msgid "· %1 skipped"
msgstr "· %1 übersprungen"

#: package/contents/ui/FullRepresentation.qml:325
msgid "⏸ Paused – voice stopped"
msgstr "⏸ Pausiert – Stimme angehalten"

#: package/contents/ui/FullRepresentation.qml:326
msgid "↻ Jumped to the new position"
msgstr "↻ Zur neuen Stelle gesprungen"

#: package/contents/ui/FullRepresentation.qml:368
msgid "Waiting for speech (%1) …"
msgstr "Warte auf Sprache (%1) …"

#: package/contents/ui/FullRepresentation.qml:369
msgid ""
"Switch translation on above and play a video – YouTube, Udemy or anything "
"else."
msgstr ""
"Schalte die Übersetzung oben ein und spiele ein Video ab – YouTube, Udemy "
"oder irgendetwas anderes."

#: package/contents/ui/FullRepresentation.qml:386
msgid "Voice"
msgstr "Stimme"

#: package/contents/ui/FullRepresentation.qml:387
msgid "Sound"
msgstr "Ton"

#: package/contents/ui/FullRepresentation.qml:388
msgid "Sync"
msgstr "Sync"

#: package/contents/ui/FullRepresentation.qml:389
msgid "History"
msgstr "Verlauf"

#: package/contents/ui/FullRepresentation.qml:414
msgid "Female voice"
msgstr "Weibliche Stimme"

#: package/contents/ui/FullRepresentation.qml:415
msgid "Male voice"
msgstr "Männliche Stimme"

#: package/contents/ui/FullRepresentation.qml:434
msgid "Speaker (%1)"
msgstr "Sprecher (%1)"

#: package/contents/ui/FullRepresentation.qml:449
msgid "Listen"
msgstr "Anhören"

#: package/contents/ui/FullRepresentation.qml:456
msgid ""
"Microsoft neural voices – they sound like real speakers. “Very natural” "
"marks the newest models."
msgstr ""
"Microsoft-Neural-Stimmen – klingen wie echte Sprecher. „Sehr natürlich“ sind"
" die neuesten Modelle."

#: package/contents/ui/FullRepresentation.qml:472
msgid "Base speaking rate"
msgstr "Grund-Sprechtempo"

#: package/contents/ui/FullRepresentation.qml:480
msgid "Pitch"
msgstr "Tonhöhe"

#: package/contents/ui/FullRepresentation.qml:489
msgid "Voice volume"
msgstr "Lautstärke der Stimme"

#: package/contents/ui/FullRepresentation.qml:516
msgid "Original volume"
msgstr "Lautstärke des Originals"

#: package/contents/ui/FullRepresentation.qml:530
msgid "Lower the original while speaking"
msgstr "Original beim Sprechen absenken"

#: package/contents/ui/FullRepresentation.qml:533
msgid "Like a dubbed film: music and sounds stay quietly audible"
msgstr ""
"Wie bei einer Synchronisation: Musik und Geräusche bleiben leise hörbar"

#: package/contents/ui/FullRepresentation.qml:548
msgid "Lower original to"
msgstr "Original absenken auf"

#: package/contents/ui/FullRepresentation.qml:555
msgid "Presets"
msgstr "Schnellwahl"

#: package/contents/ui/FullRepresentation.qml:561
msgid "Translation only"
msgstr "Nur Übersetzung"

#: package/contents/ui/FullRepresentation.qml:562
#: package/contents/ui/FullRepresentation.qml:624
msgid "Dub"
msgstr "Synchronisation"

#: package/contents/ui/FullRepresentation.qml:563
msgid "Interpreter"
msgstr "Dolmetscher"

#: package/contents/ui/FullRepresentation.qml:564
msgid "Both equal"
msgstr "Beides gleich"

#: package/contents/ui/FullRepresentation.qml:584
msgid "Subtitle window"
msgstr "Untertitel-Fenster"

#: package/contents/ui/FullRepresentation.qml:587
msgid "Floating live subtitles above all windows, movable with the mouse"
msgstr ""
"Schwebende Live-Untertitel über allen Fenstern, mit der Maus verschiebbar"

#: package/contents/ui/FullRepresentation.qml:600
msgid "Also show the original text"
msgstr "Originaltext mit anzeigen"

#: package/contents/ui/FullRepresentation.qml:631
msgid "Follow seeking & pausing"
msgstr "Beim Spulen & Pausieren mitspringen"

#: package/contents/ui/FullRepresentation.qml:635
msgid ""
"Detects seeking and pausing in YouTube, Udemy, VLC … and drops everything "
"old immediately"
msgstr ""
"Erkennt Vor-/Zurückspulen und Pause in YouTube, Udemy, VLC … und verwirft "
"sofort alles Alte"

#: package/contents/ui/FullRepresentation.qml:636
msgid "Media detection not connected yet – switch the widget off and on"
msgstr "Medien-Erkennung noch nicht verbunden – Widget aus- und einschalten"

#: package/contents/ui/FullRepresentation.qml:653
msgid "Adapt tempo automatically"
msgstr "Tempo automatisch anpassen"

#: package/contents/ui/FullRepresentation.qml:656
msgid ""
"If the original is spoken fast, the voice speaks faster too – without "
"sounding higher. Sentences are never cut off."
msgstr ""
"Spricht das Original schnell, spricht auch die Stimme schneller – ohne höher"
" zu klingen. Sätze werden nie abgeschnitten."

#: package/contents/ui/FullRepresentation.qml:673
msgid "Emergency jump on large backlog"
msgstr "Notfall-Sprung bei großem Rückstand"

#: package/contents/ui/FullRepresentation.qml:676
msgid ""
"Only if even the faster tempo is not enough: jumps to the current position "
"between two sentences"
msgstr ""
"Nur wenn selbst das schnellere Tempo nicht reicht: springt zwischen zwei "
"Sätzen zur aktuellen Stelle"

#: package/contents/ui/FullRepresentation.qml:691
msgid "Jump only after a backlog of"
msgstr "Springen erst ab Rückstand von"

#: package/contents/ui/FullRepresentation.qml:700
msgid "Recognition & translation"
msgstr "Erkennung & Übersetzung"

#: package/contents/ui/FullRepresentation.qml:706
msgid "Speech recognition"
msgstr "Spracherkennung"

#: package/contents/ui/FullRepresentation.qml:716
msgid "Responsiveness"
msgstr "Reaktionszeit"

#: package/contents/ui/FullRepresentation.qml:726
msgid "Translator"
msgstr "Übersetzer"

#: package/contents/ui/FullRepresentation.qml:737
msgid "DeepL API key (free at deepl.com/pro-api)"
msgstr "DeepL-API-Schlüssel (kostenlos bei deepl.com/pro-api)"

#: package/contents/ui/FullRepresentation.qml:744
msgid "Sensitivity (higher = ignores quiet noise)"
msgstr "Empfindlichkeit (höher = ignoriert leise Geräusche)"

#: package/contents/ui/FullRepresentation.qml:754
msgid ""
"Whisper runs privately on your computer. Switching languages briefly loads a"
" matching model the first time."
msgstr ""
"Whisper läuft privat auf deinem Rechner. Ein Sprachwechsel lädt beim ersten "
"Mal kurz ein passendes Modell."

#: package/contents/ui/FullRepresentation.qml:762
msgid "Run setup again"
msgstr "Einrichtung erneut ausführen"

#: package/contents/ui/FullRepresentation.qml:809
msgid "Nothing translated yet"
msgstr "Noch nichts übersetzt"

#: package/contents/ui/FullRepresentation.qml:822
msgid "Copy all"
msgstr "Alles kopieren"

#: package/contents/ui/FullRepresentation.qml:837
msgid "Clear"
msgstr "Leeren"

#: package/contents/ui/LanguageCombo.qml:49
msgid "Unpin"
msgstr "Von oben entfernen"

#: package/contents/ui/LanguageCombo.qml:49
msgid "Pin to top"
msgstr "Nach oben anheften"

